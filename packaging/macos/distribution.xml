<?xml version="1.0" encoding="utf-8"?>
<!-- Installer layout for build-pkg.sh; @VERSION@ is replaced at build time. -->
<installer-gui-script minSpecVersion="2">
    <title>Floorplan @VERSION@</title>
    <license file="LICENSE.txt"/>
    <options customize="allow" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="11.0"/>
        </allowed-os-versions>
    </volume-check>

    <choices-outline>
        <line choice="vst3"/>
        <line choice="app"/>
    </choices-outline>
    <choice id="vst3" title="VST3 plugin" description="Installs Floorplan.vst3 in /Library/Audio/Plug-Ins/VST3.">
        <pkg-ref id="io.github.kuzuw.floorplan.vst3"/>
    </choice>
    <choice id="app" title="Standalone app" description="Installs Floorplan.app in /Applications.">
        <pkg-ref id="io.github.kuzuw.floorplan.app"/>
    </choice>

    <pkg-ref id="io.github.kuzuw.floorplan.vst3" version="@VERSION@" onConclusion="none">Floorplan-vst3.pkg</pkg-ref>
    <pkg-ref id="io.github.kuzuw.floorplan.app" version="@VERSION@" onConclusion="none">Floorplan-app.pkg</pkg-ref>
</installer-gui-script>
